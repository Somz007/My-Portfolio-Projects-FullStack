PORT=5002
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/auth-system?retryWrites=true&w=majority

# JWT — two separate secrets (access token is short-lived, refresh is long-lived)
JWT_SECRET=replace_with_long_random_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_different_long_random_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# Reset / verify tokens expire in 10 minutes
RESET_TOKEN_EXPIRES_MIN=10

# Email — leave blank in dev to auto-create an Ethereal test account.
# The server logs an Ethereal preview URL after each email so you can
# read the message without needing a real inbox.
# For production: swap these for your real SMTP provider.
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="Auth System <noreply@authsystem.dev>"

# Frontend URL used in email links
CLIENT_URL=http://localhost:5174
# For production on GitHub Pages: https://somz007.github.io/My-Portfolio-Projects-FullStack/
