PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/mern-blog?retryWrites=true&w=majority&appName=Cluster0
JWT_SECRET=replace_with_long_random_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_different_long_random_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d
# Frontend URL — used for CORS in production (e.g. https://yourblog.netlify.app)
CLIENT_URL=http://localhost:5173
