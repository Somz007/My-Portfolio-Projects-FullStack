# ─────────────────────────────────────────────────────────────
#  Environment variables template.
#  Copy this file to ".env" and fill in your own values.
#  The real ".env" file is git-ignored so secrets never get committed.
# ─────────────────────────────────────────────────────────────

# The port your server listens on (local development).
PORT=5000

# Your MongoDB connection string.
#  - Local MongoDB:   mongodb://127.0.0.1:27017/task-manager
#  - MongoDB Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/task-manager
MONGO_URI=mongodb://127.0.0.1:27017/task-manager

# ── Access token ──────────────────────────────────────────────
# Secret used to SIGN and VERIFY short-lived ACCESS tokens.
# Make this a long, random string. Anyone who knows it can forge tokens.
JWT_SECRET=replace_this_with_a_long_random_secret_string
# How long an access token is valid. Keep it SHORT (e.g. "15m").
JWT_ACCESS_EXPIRES_IN=15m

# ── Refresh token ─────────────────────────────────────────────
# A DIFFERENT secret used to sign long-lived REFRESH tokens, so an
# access token can never be reused as a refresh token (and vice versa).
JWT_REFRESH_SECRET=replace_this_with_ANOTHER_long_random_secret_string
# How long a refresh token is valid before the user must log in again.
JWT_REFRESH_EXPIRES_IN=7d
